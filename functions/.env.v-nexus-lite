# Directive 27: non-secret parameters for the PRODUCTION target (project v-nexus-lite).
# Loaded by the Firebase CLI for `firebase deploy --project v-nexus-lite`. Every value
# is checked against config/environments.json when the backend loads; a mismatch
# fails deploy discovery. Secrets (RAZORPAY_*_SECRET) live in Secret Manager only.
DSBC_ENVIRONMENT=production
DSBC_FIRESTORE_DATABASE=ai-studio-37d17c3e-5c08-4bde-9163-8b8b6e0b2bb5
DSBC_FUNCTIONS_REGION=us-west1
# No public origin is designated yet (config/environments.json publicOrigin: null).
DSBC_PUBLIC_ORIGIN=
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
