{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "singleProjectMode": true,
    "hub": {
      "host": "127.0.0.1",
      "port": 4480
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 4580
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8180
    },
    "auth": {
      "host": "127.0.0.1",
      "port": 9477
    },
    "ui": {
      "enabled": false
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5481
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9479
    },
    "eventarc": {
      "host": "127.0.0.1",
      "port": 9480
    },
    "pubsub": {
      "host": "127.0.0.1",
      "port": 8581
    },
    "tasks": {
      "host": "127.0.0.1",
      "port": 9481
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
