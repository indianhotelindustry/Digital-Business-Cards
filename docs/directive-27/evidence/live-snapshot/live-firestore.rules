rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAppOwner() {
      return isAuthenticated() && (
        request.auth.token.email == 'owner@saas-cards.io' ||
        request.auth.token.email == 'theindianhotelindustry@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().role == 'app_owner')
      );
    }

    function isCompanyActive(companyId) {
      return exists(/databases/$(database)/documents/companies/$(companyId)) && 
        get(/databases/$(database)/documents/companies/$(companyId)).data.status == 'active';
    }
    
    function isCompanyAdmin(companyId) {
      return isAuthenticated() && 
        isCompanyActive(companyId) &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().role == 'company_admin' && 
        getUserData().companyId == companyId;
    }
    
    function isEmployee(employeeId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().role == 'employee' && 
        getUserData().employeeId == employeeId;
    }

    // users collection - Strict Self-Isolation
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        isAppOwner()
      );
      allow create: if (isAuthenticated() && (
        request.auth.uid == userId || isAppOwner()
      ) && (
        request.resource.data.role != 'app_owner' || 
        request.auth.token.email == 'theindianhotelindustry@gmail.com' || 
        isAppOwner()
      )) || (
        !exists(/databases/$(database)/documents/companies/company_acme) &&
        userId in ['user_app_owner_demo', 'user_admin_acme_demo', 'user_admin_nexus_demo', 'user_emp_rahul_demo']
      );
      // Forbid ordinary users from altering their own role, companyId, or employeeId
      allow update: if isAppOwner() || (
        isAuthenticated() && 
        request.auth.uid == userId && 
        request.resource.data.role == resource.data.role && 
        request.resource.data.companyId == resource.data.companyId && 
        request.resource.data.employeeId == resource.data.employeeId
      );
      allow delete: if isAppOwner();
    }

    // companies collection
    match /companies/{companyId} {
      // Public card view needs active company branding (logo, name, colors)
      allow read: if (resource != null && resource.data.status == 'active') || 
        isAppOwner() || 
        (isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().companyId == companyId);
      allow create: if isAppOwner() || (
        !exists(/databases/$(database)/documents/companies/company_acme) &&
        companyId in ['company_acme', 'company_nexus']
      );
      // Company Admin cannot change company id, planId, or status (cannot self-unsuspend)
      allow update: if isAppOwner() || (
        isCompanyAdmin(companyId) && 
        request.resource.data.id == resource.data.id && 
        request.resource.data.status == resource.data.status && 
        request.resource.data.planId == resource.data.planId
      );
      allow delete: if isAppOwner();
    }

    // departments collection
    match /departments/{departmentId} {
      allow read: if (resource != null && resource.data.status == 'active' && isCompanyActive(resource.data.companyId)) ||
        isAppOwner() || 
        (isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().companyId == resource.data.companyId);
      allow create: if isAppOwner() || 
        isCompanyAdmin(request.resource.data.companyId) || (
          !exists(/databases/$(database)/documents/companies/company_acme) &&
          request.resource.data.companyId in ['company_acme', 'company_nexus']
        );
      allow update: if isAppOwner() || (
        isCompanyAdmin(resource.data.companyId) && 
        request.resource.data.companyId == resource.data.companyId
      );
      allow delete: if isAppOwner() || 
        isCompanyAdmin(resource.data.companyId);
    }

    // employees collection
    match /employees/{employeeId} {
      // Public can read active employee profile for card if company is active
      allow read: if (resource != null && resource.data.status == 'active' && isCompanyActive(resource.data.companyId)) || 
        isAppOwner() || 
        (isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().companyId == resource.data.companyId);
      // Admin create: cannot inject department belonging to another company
      allow create: if isAppOwner() || (
        isCompanyAdmin(request.resource.data.companyId) && 
        (request.resource.data.departmentId == null || 
         get(/databases/$(database)/documents/departments/$(request.resource.data.departmentId)).data.companyId == request.resource.data.companyId)
      ) || (
        !exists(/databases/$(database)/documents/companies/company_acme) &&
        request.resource.data.companyId in ['company_acme', 'company_nexus']
      );
      // Admin update: cannot cross-assign department. Employee update: limited to self-service contact fields
      allow update: if isAppOwner() || (
        isCompanyAdmin(resource.data.companyId) && 
        request.resource.data.companyId == resource.data.companyId && 
        (request.resource.data.departmentId == null || 
         get(/databases/$(database)/documents/departments/$(request.resource.data.departmentId)).data.companyId == resource.data.companyId)
      ) || (
        isAuthenticated() && 
        isCompanyActive(resource.data.companyId) &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().role == 'employee' && 
        getUserData().employeeId == employeeId && 
        request.resource.data.companyId == resource.data.companyId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'displayName', 'designation',
          'phone', 'whatsapp', 'bio', 'profilePhotoUrl', 'website', 
          'linkedin', 'instagram', 'otherSocialLinks', 'updatedAt'
        ])
      );
      allow delete: if isAppOwner() || 
        isCompanyAdmin(resource.data.companyId);
    }

    // cards collection
    match /cards/{cardId} {
      // Public can read active cards only if associated company is active
      allow read: if (resource != null && resource.data.status == 'active' && isCompanyActive(resource.data.companyId)) || 
        isAppOwner() || 
        (isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().companyId == resource.data.companyId);
      // Admin create: card employeeId must belong to the same company
      allow create: if isAppOwner() || (
        isCompanyAdmin(request.resource.data.companyId) && 
        get(/databases/$(database)/documents/employees/$(request.resource.data.employeeId)).data.companyId == request.resource.data.companyId
      ) || (
        !exists(/databases/$(database)/documents/companies/company_acme) &&
        request.resource.data.companyId in ['company_acme', 'company_nexus']
      );
      // Admin update: companyId immutable, employee must belong to same company
      allow update: if isAppOwner() || (
        isCompanyAdmin(resource.data.companyId) && 
        request.resource.data.companyId == resource.data.companyId && 
        get(/databases/$(database)/documents/employees/$(request.resource.data.employeeId)).data.companyId == resource.data.companyId
      );
      allow delete: if isAppOwner() || 
        isCompanyAdmin(resource.data.companyId);
    }

    // cardTemplates collection
    match /cardTemplates/{templateId} {
      allow read: if true;
      allow write: if isAppOwner() || !exists(/databases/$(database)/documents/companies/company_acme);
    }

    // analytics collection - Strict Cross-Tenant Injection Guard
    match /analytics/{eventId} {
      allow create: if request.resource.data.eventType in [
        'card_view', 'phone_click', 'whatsapp_click', 'email_click', 
        'website_click', 'linkedin_click', 'save_contact', 'share'
      ] && 
      exists(/databases/$(database)/documents/cards/$(request.resource.data.cardId)) && 
      get(/databases/$(database)/documents/cards/$(request.resource.data.cardId)).data.companyId == request.resource.data.companyId && 
      get(/databases/$(database)/documents/cards/$(request.resource.data.cardId)).data.employeeId == request.resource.data.employeeId;
      
      allow read: if isAppOwner() || 
        (isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && isCompanyAdmin(resource.data.companyId));
      allow update, delete: if isAppOwner();
    }

    // ====================================================
    // DSBC V2.0 CONNECT FOUNDATION SECURITY RULES
    // ====================================================

    // contacts collection - Strictly User-Scoped Personal Address Book
    match /contacts/{contactId} {
      allow read: if isAuthenticated() && resource.data.ownerUserId == request.auth.uid;
      allow create: if (
        isAuthenticated() && request.resource.data.ownerUserId == request.auth.uid
      ) || (
        !exists(/databases/$(database)/documents/companies/company_acme)
      );
      allow update: if (
        isAuthenticated() && 
        resource.data.ownerUserId == request.auth.uid && 
        request.resource.data.ownerUserId == resource.data.ownerUserId
      );
      allow delete: if (
        isAuthenticated() && resource.data.ownerUserId == request.auth.uid
      );
    }

    // connections collection - Mutual Connection State Machine
    match /connections/{connectionId} {
      // Participants or App Owner can read
      allow read: if isAppOwner() || (
        isAuthenticated() && (
          resource.data.requesterUserId == request.auth.uid || 
          resource.data.recipientUserId == request.auth.uid ||
          (resource.data.recipientUserId == null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().employeeId == resource.data.recipientIdentityId)
        )
      );
      
      // Intentional Connection Request creation
      allow create: if isAppOwner() || (
        isAuthenticated() && request.resource.data.requesterUserId == request.auth.uid && 
        request.resource.data.status in ['requested', 'pending']
      ) || (
        // Public intentional contact exchange request from external visitor
        request.resource.data.status in ['requested', 'pending'] &&
        exists(/databases/$(database)/documents/companies/$(request.resource.data.recipientCompanyId))
      ) || (
        !exists(/databases/$(database)/documents/companies/company_acme)
      );

      // State updates: participants only, immutable identities, companies, and timestamps, cannot unblock unilaterally
      allow update: if isAppOwner() || (
        isAuthenticated() && (
          resource.data.requesterUserId == request.auth.uid || 
          resource.data.recipientUserId == request.auth.uid ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().employeeId == resource.data.recipientIdentityId)
        ) && 
        request.resource.data.requesterUserId == resource.data.requesterUserId &&
        request.resource.data.recipientIdentityId == resource.data.recipientIdentityId &&
        request.resource.data.requesterIdentityId == resource.data.requesterIdentityId &&
        request.resource.data.recipientCompanyId == resource.data.recipientCompanyId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        // Blocked state cannot silently revert
        (resource.data.status != 'blocked' || request.resource.data.status == 'blocked')
      );

      allow delete: if isAppOwner() || (
        isAuthenticated() && resource.data.requesterUserId == request.auth.uid
      );
    }

    // relationshipNotes collection - Strictly Private to Note Author
    match /relationshipNotes/{noteId} {
      allow read: if (
        isAuthenticated() && resource.data.ownerUserId == request.auth.uid
      );
      allow create: if (
        isAuthenticated() && request.resource.data.ownerUserId == request.auth.uid
      ) || (
        !exists(/databases/$(database)/documents/companies/company_acme)
      );
      allow update: if (
        isAuthenticated() && 
        resource.data.ownerUserId == request.auth.uid && 
        request.resource.data.ownerUserId == resource.data.ownerUserId
      );
      allow delete: if (
        isAuthenticated() && resource.data.ownerUserId == request.auth.uid
      );
    }

    // followUps collection - Strictly Private to User
    match /followUps/{followUpId} {
      allow read: if (
        isAuthenticated() && resource.data.ownerUserId == request.auth.uid
      );
      allow create: if (
        isAuthenticated() && request.resource.data.ownerUserId == request.auth.uid
      ) || (
        !exists(/databases/$(database)/documents/companies/company_acme)
      );
      allow update: if (
        isAuthenticated() && 
        resource.data.ownerUserId == request.auth.uid && 
        request.resource.data.ownerUserId == resource.data.ownerUserId
      );
      allow delete: if (
        isAuthenticated() && resource.data.ownerUserId == request.auth.uid
      );
    }

    // connectionEvents collection - Append-only Relationship Timeline (Immutable Audit Trail)
    match /connectionEvents/{eventId} {
      allow read: if isAppOwner() || (
        isAuthenticated() && (
          resource.data.ownerUserId == request.auth.uid || 
          request.auth.uid in resource.data.participantUserIds
        )
      );
      allow create: if isAppOwner() || (
        isAuthenticated() && (
          request.resource.data.actorUserId == request.auth.uid || 
          request.resource.data.ownerUserId == request.auth.uid
        )
      ) || (
        // Public initial connection event
        request.resource.data.eventType == 'CONNECTION_REQUESTED'
      ) || (
        !exists(/databases/$(database)/documents/companies/company_acme)
      );
      // History is immutable; direct updates and deletions are strictly forbidden
      allow update, delete: if false;
    }

    // ====================================================
    // DSBC V2.1 EVENTS, CAMPAIGNS & LEAD CAPTURE SECURITY RULES
    // ====================================================

    // events collection - Company-Scoped Events & Expos
    match /events/{eventId} {
      allow read: if isAppOwner() || (
        isAuthenticated() && 
        isCompanyActive(resource.data.companyId) && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().companyId == resource.data.companyId
      );
      allow create: if isAppOwner() || (
        isCompanyAdmin(request.resource.data.companyId)
      ) || (
        !exists(/databases/$(database)/documents/companies/company_acme)
      );
      allow update: if isAppOwner() || (
        isCompanyAdmin(resource.data.companyId) && 
        request.resource.data.companyId == resource.data.companyId
      );
      allow delete: if isAppOwner() || 
        isCompanyAdmin(resource.data.companyId);
    }

    // eventMembers collection - Enrolled Employees in Event
    match /eventMembers/{memberId} {
      allow read: if isAppOwner() || (
        isAuthenticated() && 
        isCompanyActive(resource.data.companyId) && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().companyId == resource.data.companyId
      );
      allow create: if isAppOwner() || (
        isCompanyAdmin(request.resource.data.companyId)
      ) || (
        isAuthenticated() && 
        isCompanyActive(request.resource.data.companyId) && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().companyId == request.resource.data.companyId &&
        getUserData().employeeId == request.resource.data.employeeId
      ) || (
        !exists(/databases/$(database)/documents/companies/company_acme)
      );
      allow update: if isAppOwner() || 
        isCompanyAdmin(resource.data.companyId);
      allow delete: if isAppOwner() || 
        isCompanyAdmin(resource.data.companyId) || (
          isAuthenticated() && 
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          getUserData().employeeId == resource.data.employeeId
        );
    }

    // campaigns collection - Attribution Channels & Booth QRs
    match /campaigns/{campaignId} {
      // Public can read active campaigns for booth routing & tracking
      allow read: if (resource != null && resource.data.status == 'active' && isCompanyActive(resource.data.companyId)) ||
        isAppOwner() || (
          isAuthenticated() && 
          isCompanyActive(resource.data.companyId) && 
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          getUserData().companyId == resource.data.companyId
        );
      allow create: if isAppOwner() || 
        isCompanyAdmin(request.resource.data.companyId) || (
          !exists(/databases/$(database)/documents/companies/company_acme)
        );
      allow update: if isAppOwner() || (
        isCompanyAdmin(resource.data.companyId) && 
        request.resource.data.companyId == resource.data.companyId
      );
      allow delete: if isAppOwner() || 
        isCompanyAdmin(resource.data.companyId);
    }

    // leads collection - Company-Owned Business Leads (Personal Contacts NOT shared)
    match /leads/{leadId} {
      allow read: if isAppOwner() || (
        isAuthenticated() && 
        isCompanyActive(resource.data.companyId) && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().companyId == resource.data.companyId
      );
      allow create: if isAppOwner() || (
        isAuthenticated() && 
        isCompanyActive(request.resource.data.companyId) && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().companyId == request.resource.data.companyId
      ) || (
        !exists(/databases/$(database)/documents/companies/company_acme)
      );
      allow update: if isAppOwner() || (
        isAuthenticated() && 
        isCompanyActive(resource.data.companyId) && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().companyId == resource.data.companyId &&
        request.resource.data.companyId == resource.data.companyId
      );
      allow delete: if isAppOwner() || 
        isCompanyAdmin(resource.data.companyId);
    }

    // leadNotes collection - Company-Owned Lead Notes (Isolated from Private Notes)
    match /leadNotes/{noteId} {
      allow read: if isAppOwner() || (
        isAuthenticated() && 
        isCompanyActive(resource.data.companyId) && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().companyId == resource.data.companyId
      );
      allow create: if isAppOwner() || (
        isAuthenticated() && 
        isCompanyActive(request.resource.data.companyId) && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().companyId == request.resource.data.companyId &&
        request.resource.data.authorUserId == request.auth.uid
      ) || (
        !exists(/databases/$(database)/documents/companies/company_acme)
      );
      allow update: if isAppOwner() || (
        isAuthenticated() && 
        resource.data.authorUserId == request.auth.uid && 
        request.resource.data.companyId == resource.data.companyId
      );
      allow delete: if isAppOwner() || 
        isCompanyAdmin(resource.data.companyId) || (
          isAuthenticated() && resource.data.authorUserId == request.auth.uid
        );
    }

    // leadEvents collection - Append-Only Immutable Lead Audit Trail
    match /leadEvents/{eventId} {
      allow read: if isAppOwner() || (
        isAuthenticated() && 
        isCompanyActive(resource.data.companyId) && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().companyId == resource.data.companyId
      );
      allow create: if isAppOwner() || (
        isAuthenticated() && 
        isCompanyActive(request.resource.data.companyId) && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().companyId == request.resource.data.companyId
      ) || (
        !exists(/databases/$(database)/documents/companies/company_acme)
      );
      // Lead audit timeline is strictly immutable
      allow update, delete: if false;
    }

    // ====================================================
    // DSBC V2.2 DIGITAL IDENTITY PROFILES & TEMPLATES
    // ====================================================
    match /digitalIdentityProfiles/{employeeId} {
      // Public card view requires access to employee presentation profile
      allow read: if (resource != null && isCompanyActive(resource.data.companyId)) || 
        isAppOwner() || 
        (isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().companyId == resource.data.companyId);
      allow create: if isAppOwner() || 
        isCompanyAdmin(request.resource.data.companyId) || (
          isAuthenticated() && 
          isCompanyActive(request.resource.data.companyId) && 
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          getUserData().employeeId == employeeId && 
          getUserData().companyId == request.resource.data.companyId
        ) || (
          !exists(/databases/$(database)/documents/companies/company_acme)
        );
      allow update: if isAppOwner() || (
        isCompanyAdmin(resource.data.companyId) && 
        request.resource.data.companyId == resource.data.companyId &&
        request.resource.data.employeeId == resource.data.employeeId
      ) || (
        isAuthenticated() && 
        isCompanyActive(resource.data.companyId) && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().employeeId == employeeId && 
        getUserData().companyId == resource.data.companyId &&
        request.resource.data.companyId == resource.data.companyId &&
        request.resource.data.employeeId == resource.data.employeeId
      );
      allow delete: if isAppOwner() || isCompanyAdmin(resource.data.companyId);
    }

    // ====================================================
    // DSBC V2.5 SAAS ENTITLEMENT & APP OWNER CONTROL SYSTEM
    // ====================================================
    match /plans/{planId} {
      allow read: if true; // Public pricing and entitlement resolution
      allow write: if isAppOwner() || (!exists(/databases/$(database)/documents/companies/company_acme));
    }

    match /entitlementOverrides/{overrideId} {
      allow read: if isAppOwner() || (
        isAuthenticated() && (
          (resource.data.targetType == 'company' && getUserData().companyId == resource.data.targetId) ||
          (resource.data.targetType == 'individual' && (getUserData().employeeId == resource.data.targetId || request.auth.uid == resource.data.targetId))
        )
      );
      allow write: if isAppOwner() || (!exists(/databases/$(database)/documents/companies/company_acme));
    }

    match /globalPolicies/{policyId} {
      allow read: if true;
      allow write: if isAppOwner() || (!exists(/databases/$(database)/documents/companies/company_acme));
    }

    match /entitlementAuditLogs/{auditId} {
      allow read: if isAppOwner();
      allow create: if isAppOwner() || (!exists(/databases/$(database)/documents/companies/company_acme));
      allow update, delete: if false; // Immutable audit log
    }

    // ====================================================
    // DSBC V2.6 COMMERCIAL SUBSCRIPTION & BILLING SYSTEM
    // ====================================================
    match /subscriptions/{subscriptionId} {
      allow read: if isAppOwner() || (
        isAuthenticated() && (
          (resource.data.customerType == 'company' && getUserData().companyId == resource.data.customerId) ||
          (resource.data.customerType == 'individual' && (getUserData().employeeId == resource.data.customerId || request.auth.uid == resource.data.customerId))
        )
      );
      allow write: if isAppOwner() || (!exists(/databases/$(database)/documents/companies/company_acme));
    }

    match /invoices/{invoiceId} {
      allow read: if isAppOwner() || (
        isAuthenticated() && (
          (resource.data.customerType == 'company' && getUserData().companyId == resource.data.customerId) ||
          (resource.data.customerType == 'individual' && (getUserData().employeeId == resource.data.customerId || request.auth.uid == resource.data.customerId))
        )
      );
      allow write: if isAppOwner() || (!exists(/databases/$(database)/documents/companies/company_acme));
    }

    match /commercialAuditLogs/{auditId} {
      allow read: if isAppOwner();
      allow create: if isAppOwner() || (!exists(/databases/$(database)/documents/companies/company_acme));
      allow update, delete: if false; // Immutable commercial audit log
    }
  }
}
