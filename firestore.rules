rules_version = '2';

// ============================================================================
// DSBC Firestore Security Rules — Directive 24 (Phases 2–4) + Directive 25
// ----------------------------------------------------------------------------
// Principles
//   * Deny by default. Nothing is allowed because a document is ABSENT
//     (the former `!exists(companies/company_acme)` bootstrap is gone).
//     Bootstrap/demo data is written only by scripts/admin/* with Admin SDK.
//   * App Owner authority = custom claim platformRole == 'app_owner', set only
//     by scripts/admin/setAppOwner.ts, on an identity with a verified email.
//     No email allow-list, no trust in users/{uid}.role for App Owner.
//   * Registration establishes identity + requested account type only. Role,
//     companyId, tenant and plan are fixed by these rules, not the client.
//   * Tenant role and membership (users.role / companyId / employeeId /
//     status / tenantId / accountType) are never client-writable afterwards.
//   * Commercial authority (plans, policies, overrides, subscriptions,
//     invoices, audit logs) is read-only for every client; only a trusted
//     backend (Admin SDK) may write it.
//   * Directive 25: the backend (Cloud Functions, Admin SDK) is the only writer
//     of the commercial control plane, usage counters, payment orders,
//     webhook ledger, publishing records, slugs and audit ledgers. Fields the
//     backend mirrors onto tenant content (seatState, seatLockedAt,
//     platformSuspended, publicationHidden) are immutable for clients and hide
//     content publicly.
// Tests: tests/rules/*.test.ts (npm run test:rules, Firebase Emulator only).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Identity helpers
    // ------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAppOwner() {
      return isSignedIn()
        && request.auth.token.get('platformRole', '') == 'app_owner'
        && request.auth.token.get('email_verified', false) == true;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasProfile() {
      return isSignedIn() && exists(userPath(request.auth.uid));
    }

    function me() {
      return get(userPath(request.auth.uid)).data;
    }

    function isActiveProfile() {
      return hasProfile() && me().status == 'active';
    }

    function isNonEmptyString(v) {
      return v is string && v.size() > 0;
    }

    // ------------------------------------------------------------------------
    // Tenant helpers
    // ------------------------------------------------------------------------
    function companyPath(companyId) {
      return /databases/$(database)/documents/companies/$(companyId);
    }

    function tenantPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId);
    }

    function isCompanyActive(companyId) {
      return isNonEmptyString(companyId)
        && exists(companyPath(companyId))
        && get(companyPath(companyId)).data.status == 'active';
    }

    // Any active profile whose companyId is this company (any role).
    function isMemberOf(companyId) {
      return isNonEmptyString(companyId) && isActiveProfile() && me().companyId == companyId;
    }

    function isActiveMemberOf(companyId) {
      return isMemberOf(companyId) && isCompanyActive(companyId);
    }

    function isCompanyAdmin(companyId) {
      return isMemberOf(companyId) && me().role == 'company_admin' && isCompanyActive(companyId);
    }

    function isSelfEmployee(employeeId) {
      return isNonEmptyString(employeeId)
        && isActiveProfile()
        && me().role == 'employee'
        && me().employeeId == employeeId;
    }

    function departmentBelongsTo(departmentId, companyId) {
      return departmentId == null
        || get(/databases/$(database)/documents/departments/$(departmentId)).data.companyId == companyId;
    }

    function employeeBelongsTo(employeeId, companyId) {
      return get(/databases/$(database)/documents/employees/$(employeeId)).data.companyId == companyId;
    }

    // ------------------------------------------------------------------------
    // Change helpers
    // ------------------------------------------------------------------------
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function unchanged(fields) {
      return !changedKeys().hasAny(fields);
    }

    function onlyChanges(fields) {
      return changedKeys().hasOnly(fields);
    }

    // Directive 25: backend-owned enforcement fields on tenant content.
    function noBackendFieldsOnCreate() {
      return !request.resource.data.keys().hasAny(['seatState', 'seatLockedAt', 'platformSuspended', 'publicationHidden']);
    }

    function notPlatformSuspended(data) {
      return data.get('platformSuspended', false) != true;
    }

    // DRAFT / UNPUBLISHED, mirrored by the backend's setPublishingState.
    function notPublicationHidden(data) {
      return data.get('publicationHidden', false) != true;
    }

    function seatNotLocked(data) {
      return data.get('seatState', '') != 'locked';
    }

    // ------------------------------------------------------------------------
    // Registration (Phase 2): one batch writes users/{uid} + tenants/{id}
    // (+ companies/co_<uid> for company accounts). The caller has no profile
    // before the batch; ids are derived from the caller's uid.
    // ------------------------------------------------------------------------
    function isRegistrationInProgress() {
      return isSignedIn()
        && !exists(userPath(request.auth.uid))
        && existsAfter(userPath(request.auth.uid));
    }

    function isValidRegistrationProfile(uid) {
      let d = request.resource.data;
      let fields = ['id', 'email', 'displayName', 'role', 'companyId', 'employeeId',
                    'status', 'accountType', 'tenantId', 'createdAt', 'updatedAt'];
      return d.keys().hasOnly(fields)
        && d.keys().hasAll(fields)
        && d.id == uid
        && isNonEmptyString(d.email)
        && d.email == request.auth.token.get('email', '')
        && isNonEmptyString(d.displayName) && d.displayName.size() <= 120
        && d.status == 'active'
        && d.employeeId == null
        && d.createdAt is string
        && d.updatedAt is string
        && (
          (
            d.accountType == 'individual'
            && d.role == 'employee'
            && d.companyId == null
            && d.tenantId == 'ind_' + uid
            && getAfter(tenantPath('ind_' + uid)).data.ownerUid == uid
          ) || (
            d.accountType == 'company'
            && d.role == 'company_admin'
            && d.companyId == 'co_' + uid
            && d.tenantId == 'co_' + uid
            && getAfter(tenantPath('co_' + uid)).data.ownerUid == uid
            && getAfter(companyPath('co_' + uid)).data.ownerUid == uid
          )
        );
    }

    function isValidTenantRecord(tenantId) {
      let d = request.resource.data;
      let uid = request.auth.uid;
      let fields = ['id', 'kind', 'ownerUid', 'companyId', 'status', 'createdAt'];
      return d.keys().hasOnly(fields)
        && d.keys().hasAll(fields)
        && d.id == tenantId
        && d.ownerUid == uid
        && d.status == 'active'
        && d.createdAt is string
        && (
          (tenantId == 'ind_' + uid && d.kind == 'individual' && d.companyId == null)
          || (tenantId == 'co_' + uid && d.kind == 'company' && d.companyId == tenantId)
        );
    }

    function isValidSelfRegisteredCompany(companyId) {
      let d = request.resource.data;
      return companyId == 'co_' + request.auth.uid
        && d.id == companyId
        && d.ownerUid == request.auth.uid
        && d.kind == 'company'
        && d.status == 'active'
        && d.planId == 'company_free'
        && isNonEmptyString(d.name) && d.name.size() <= 120;
    }

    // ========================================================================
    // users
    // ========================================================================
    match /users/{userId} {
      allow read: if isAppOwner() || (isSignedIn() && request.auth.uid == userId);

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isValidRegistrationProfile(userId);

      // Users may only rename themselves. Role, membership, status, email,
      // tenant and account type are authority fields.
      allow update: if isAppOwner() || (
        isSignedIn()
        && request.auth.uid == userId
        && resource.data.status == 'active'
        && onlyChanges(['displayName', 'updatedAt'])
        && isNonEmptyString(request.resource.data.displayName)
        && request.resource.data.displayName.size() <= 120
      );

      allow delete: if isAppOwner();
    }

    // ========================================================================
    // tenants (Phase 2) — tenant registry; created only during registration
    // ========================================================================
    match /tenants/{tenantId} {
      allow read: if isAppOwner() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isRegistrationInProgress()
        && getAfter(userPath(request.auth.uid)).data.tenantId == tenantId
        && isValidTenantRecord(tenantId);
      allow update, delete: if false;
    }

    // ========================================================================
    // companies
    // ========================================================================
    match /companies/{companyId} {
      // Active companies are public (company mini-website / card branding).
      allow read: if (resource != null && resource.data.status == 'active' && notPlatformSuspended(resource.data) && notPublicationHidden(resource.data))
        || isAppOwner()
        || isMemberOf(companyId);

      allow create: if isAppOwner() || (
        isRegistrationInProgress()
        && getAfter(userPath(request.auth.uid)).data.companyId == companyId
        && isValidSelfRegisteredCompany(companyId)
      );

      // Company admins edit content only; never id, status (no self-unsuspend),
      // plan, kind or ownership.
      allow update: if isAppOwner() || (
        isCompanyAdmin(companyId)
        && unchanged(['id', 'status', 'planId', 'kind', 'ownerUid', 'platformSuspended', 'publicationHidden'])
      );

      allow delete: if isAppOwner();
    }

    // ========================================================================
    // departments
    // ========================================================================
    match /departments/{departmentId} {
      allow read: if (resource != null && resource.data.status == 'active' && isCompanyActive(resource.data.companyId))
        || isAppOwner()
        || isMemberOf(resource.data.companyId);
      allow create: if isAppOwner() || isCompanyAdmin(request.resource.data.companyId);
      allow update: if isAppOwner() || (
        isCompanyAdmin(resource.data.companyId) && unchanged(['companyId'])
      );
      allow delete: if isAppOwner() || isCompanyAdmin(resource.data.companyId);
    }

    // ========================================================================
    // employees
    // ========================================================================
    match /employees/{employeeId} {
      // Active employees of active companies are public (public card).
      allow read: if (resource != null && resource.data.status == 'active'
          && seatNotLocked(resource.data) && notPlatformSuspended(resource.data)
          && isCompanyActive(resource.data.companyId))
        || isAppOwner()
        || isMemberOf(resource.data.companyId);

      allow create: if isAppOwner() || (
        isCompanyAdmin(request.resource.data.companyId)
        && noBackendFieldsOnCreate()
        && departmentBelongsTo(request.resource.data.get('departmentId', null), request.resource.data.companyId)
      );

      allow update: if isAppOwner() || (
        isCompanyAdmin(resource.data.companyId)
        && unchanged(['companyId', 'seatState', 'seatLockedAt', 'platformSuspended'])
        && departmentBelongsTo(request.resource.data.get('departmentId', null), resource.data.companyId)
      ) || (
        isSelfEmployee(employeeId)
        && me().companyId == resource.data.companyId
        && isCompanyActive(resource.data.companyId)
        && onlyChanges([
          'firstName', 'lastName', 'displayName', 'designation',
          'phone', 'whatsapp', 'bio', 'profilePhotoUrl', 'website',
          'linkedin', 'instagram', 'otherSocialLinks', 'updatedAt'
        ])
      );

      allow delete: if isAppOwner() || isCompanyAdmin(resource.data.companyId);
    }

    // ========================================================================
    // cards
    // ========================================================================
    match /cards/{cardId} {
      allow read: if (resource != null && resource.data.status == 'active'
          && notPlatformSuspended(resource.data) && notPublicationHidden(resource.data)
          && isCompanyActive(resource.data.companyId))
        || isAppOwner()
        || isMemberOf(resource.data.companyId);

      allow create: if isAppOwner() || (
        isCompanyAdmin(request.resource.data.companyId)
        && noBackendFieldsOnCreate()
        && employeeBelongsTo(request.resource.data.employeeId, request.resource.data.companyId)
      );

      allow update: if isAppOwner() || (
        isCompanyAdmin(resource.data.companyId)
        && unchanged(['companyId', 'platformSuspended', 'publicationHidden'])
        && employeeBelongsTo(request.resource.data.employeeId, resource.data.companyId)
      );

      allow delete: if isAppOwner() || isCompanyAdmin(resource.data.companyId);
    }

    // ========================================================================
    // cardTemplates — platform catalogue
    // ========================================================================
    match /cardTemplates/{templateId} {
      allow read: if true;
      allow write: if isAppOwner();
    }

    // ========================================================================
    // analytics — public telemetry, validated against the real card
    // ========================================================================
    match /analytics/{eventId} {
      allow create: if request.resource.data.eventType in [
          'card_view', 'phone_click', 'whatsapp_click', 'email_click',
          'website_click', 'linkedin_click', 'save_contact', 'share'
        ]
        && exists(/databases/$(database)/documents/cards/$(request.resource.data.cardId))
        && get(/databases/$(database)/documents/cards/$(request.resource.data.cardId)).data.companyId == request.resource.data.companyId
        && get(/databases/$(database)/documents/cards/$(request.resource.data.cardId)).data.employeeId == request.resource.data.employeeId;
      allow read: if isAppOwner() || isCompanyAdmin(resource.data.companyId);
      allow update, delete: if isAppOwner();
    }

    // ========================================================================
    // DSBC Connect — personal, user-scoped data
    // ========================================================================
    match /contacts/{contactId} {
      allow read: if isSignedIn() && resource.data.ownerUserId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUserId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerUserId == request.auth.uid
        && unchanged(['ownerUserId']);
      allow delete: if isSignedIn() && resource.data.ownerUserId == request.auth.uid;
    }

    // Public (unauthenticated) contact-exchange request from a card visitor:
    // exactly the shape ExchangeContactModal writes, to a real active employee.
    function isValidVisitorConnectionRequest() {
      let d = request.resource.data;
      return request.auth == null
        && d.keys().hasOnly([
          'id', 'connectionVersion', 'requesterUserId', 'recipientUserId', 'requesterIdentityId',
          'recipientIdentityId', 'requesterName', 'requesterTitle', 'requesterCompany',
          'requesterEmail', 'requesterPhone', 'requesterCompanyId', 'recipientCompanyId',
          'status', 'initiatedBy', 'exchangeMethod', 'consentState', 'sharedCategories',
          'initialNote', 'createdAt', 'updatedAt', 'lastInteractionAt'
        ])
        && d.requesterUserId is string
        && d.requesterUserId.matches('^visitor_[A-Za-z0-9_]{1,64}$')
        && d.requesterIdentityId == d.requesterUserId
        && d.initiatedBy == d.requesterUserId
        && d.get('recipientUserId', null) == null
        && d.get('requesterCompanyId', null) == null
        && d.status == 'pending'
        && d.consentState == 'requested'
        && isNonEmptyString(d.requesterName) && d.requesterName.size() <= 120
        && isCompanyActive(d.recipientCompanyId)
        && isNonEmptyString(d.recipientIdentityId)
        && exists(/databases/$(database)/documents/employees/$(d.recipientIdentityId))
        && employeeBelongsTo(d.recipientIdentityId, d.recipientCompanyId);
    }

    match /connections/{connectionId} {
      allow read: if isAppOwner() || (
        isSignedIn() && (
          resource.data.requesterUserId == request.auth.uid
          || resource.data.get('recipientUserId', null) == request.auth.uid
          || (resource.data.get('recipientUserId', null) == null
              && hasProfile()
              && isNonEmptyString(me().employeeId)
              && me().employeeId == resource.data.recipientIdentityId)
        )
      );

      allow create: if isAppOwner() || (
        isSignedIn()
        && request.resource.data.requesterUserId == request.auth.uid
        && request.resource.data.status in ['requested', 'pending']
      ) || isValidVisitorConnectionRequest();

      // Participants only; identities, companies and creation time are
      // immutable; a blocked connection cannot be silently unblocked.
      allow update: if isAppOwner() || (
        isSignedIn() && (
          resource.data.requesterUserId == request.auth.uid
          || resource.data.get('recipientUserId', null) == request.auth.uid
          || (hasProfile() && isNonEmptyString(me().employeeId) && me().employeeId == resource.data.recipientIdentityId)
        )
        && unchanged(['requesterUserId', 'recipientIdentityId', 'requesterIdentityId', 'recipientCompanyId', 'createdAt'])
        && (resource.data.status != 'blocked' || request.resource.data.status == 'blocked')
      );

      allow delete: if isAppOwner() || (isSignedIn() && resource.data.requesterUserId == request.auth.uid);
    }

    match /relationshipNotes/{noteId} {
      allow read: if isSignedIn() && resource.data.ownerUserId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUserId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerUserId == request.auth.uid
        && unchanged(['ownerUserId']);
      allow delete: if isSignedIn() && resource.data.ownerUserId == request.auth.uid;
    }

    match /followUps/{followUpId} {
      allow read: if isSignedIn() && resource.data.ownerUserId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUserId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerUserId == request.auth.uid
        && unchanged(['ownerUserId']);
      allow delete: if isSignedIn() && resource.data.ownerUserId == request.auth.uid;
    }

    // Caller must be a party to the referenced connection.
    function isConnectionParty(connectionId) {
      let c = get(/databases/$(database)/documents/connections/$(connectionId)).data;
      return c.requesterUserId == request.auth.uid
        || c.get('recipientUserId', null) == request.auth.uid
        || (hasProfile() && isNonEmptyString(me().employeeId) && me().employeeId == c.recipientIdentityId);
    }

    function participantsWithinConnection(connectionId) {
      let c = get(/databases/$(database)/documents/connections/$(connectionId)).data;
      return request.resource.data.participantUserIds is list
        && request.resource.data.participantUserIds.hasOnly([c.requesterUserId, c.get('recipientUserId', '')]);
    }

    // Append-only relationship timeline. Only parties of an existing
    // connection may append, as themselves; no public writes.
    match /connectionEvents/{eventId} {
      allow read: if isAppOwner() || (
        isSignedIn() && (
          resource.data.get('ownerUserId', null) == request.auth.uid
          || request.auth.uid in resource.data.participantUserIds
        )
      );
      allow create: if isAppOwner() || (
        isSignedIn()
        && request.resource.data.actorUserId == request.auth.uid
        && request.resource.data.get('ownerUserId', null) in [null, request.auth.uid]
        && isNonEmptyString(request.resource.data.connectionId)
        && exists(/databases/$(database)/documents/connections/$(request.resource.data.connectionId))
        && isConnectionParty(request.resource.data.connectionId)
        && participantsWithinConnection(request.resource.data.connectionId)
      );
      allow update, delete: if false;
    }

    // ========================================================================
    // Events, campaigns & lead capture — company-scoped
    // ========================================================================
    match /events/{eventId} {
      allow read: if isAppOwner() || isActiveMemberOf(resource.data.companyId);
      allow create: if isAppOwner() || isCompanyAdmin(request.resource.data.companyId);
      allow update: if isAppOwner() || (
        isCompanyAdmin(resource.data.companyId) && unchanged(['companyId'])
      );
      allow delete: if isAppOwner() || isCompanyAdmin(resource.data.companyId);
    }

    match /eventMembers/{memberId} {
      allow read: if isAppOwner() || isActiveMemberOf(resource.data.companyId);
      allow create: if isAppOwner()
        || isCompanyAdmin(request.resource.data.companyId)
        || (
          isActiveMemberOf(request.resource.data.companyId)
          && me().employeeId == request.resource.data.employeeId
        );
      allow update: if isAppOwner() || (
        isCompanyAdmin(resource.data.companyId) && unchanged(['companyId'])
      );
      allow delete: if isAppOwner()
        || isCompanyAdmin(resource.data.companyId)
        || (isActiveMemberOf(resource.data.companyId) && me().employeeId == resource.data.employeeId);
    }

    match /campaigns/{campaignId} {
      // Active campaigns are public (booth QR routing & attribution).
      allow read: if (resource != null && resource.data.status == 'active' && isCompanyActive(resource.data.companyId))
        || isAppOwner()
        || isActiveMemberOf(resource.data.companyId);
      allow create: if isAppOwner() || isCompanyAdmin(request.resource.data.companyId);
      allow update: if isAppOwner() || (
        isCompanyAdmin(resource.data.companyId) && unchanged(['companyId'])
      );
      allow delete: if isAppOwner() || isCompanyAdmin(resource.data.companyId);
    }

    match /leads/{leadId} {
      allow read: if isAppOwner() || isActiveMemberOf(resource.data.companyId);
      allow create: if isAppOwner() || isActiveMemberOf(request.resource.data.companyId);
      allow update: if isAppOwner() || (
        isActiveMemberOf(resource.data.companyId) && unchanged(['companyId'])
      );
      allow delete: if isAppOwner() || isCompanyAdmin(resource.data.companyId);
    }

    match /leadNotes/{noteId} {
      allow read: if isAppOwner() || isActiveMemberOf(resource.data.companyId);
      allow create: if isAppOwner() || (
        isActiveMemberOf(request.resource.data.companyId)
        && request.resource.data.authorUserId == request.auth.uid
      );
      allow update: if isAppOwner() || (
        isActiveMemberOf(resource.data.companyId)
        && resource.data.authorUserId == request.auth.uid
        && unchanged(['companyId', 'authorUserId'])
      );
      allow delete: if isAppOwner()
        || isCompanyAdmin(resource.data.companyId)
        || (isActiveMemberOf(resource.data.companyId) && resource.data.authorUserId == request.auth.uid);
    }

    // Append-only lead audit trail.
    match /leadEvents/{eventId} {
      allow read: if isAppOwner() || isActiveMemberOf(resource.data.companyId);
      allow create: if isAppOwner() || isActiveMemberOf(request.resource.data.companyId);
      allow update, delete: if false;
    }

    // ========================================================================
    // Digital identity profiles (keyed by employeeId)
    // ========================================================================
    match /digitalIdentityProfiles/{employeeId} {
      allow read: if (resource != null && notPlatformSuspended(resource.data) && notPublicationHidden(resource.data) && isCompanyActive(resource.data.companyId))
        || isAppOwner()
        || isMemberOf(resource.data.companyId);
      allow create: if isAppOwner()
        || (isCompanyAdmin(request.resource.data.companyId) && noBackendFieldsOnCreate())
        || (
          isSelfEmployee(employeeId)
          && isActiveMemberOf(request.resource.data.companyId)
          && noBackendFieldsOnCreate()
        );
      allow update: if isAppOwner() || (
        isCompanyAdmin(resource.data.companyId)
        && unchanged(['companyId', 'employeeId', 'platformSuspended', 'publicationHidden'])
      ) || (
        isSelfEmployee(employeeId)
        && isActiveMemberOf(resource.data.companyId)
        && unchanged(['companyId', 'employeeId', 'platformSuspended', 'publicationHidden'])
      );
      allow delete: if isAppOwner() || isCompanyAdmin(resource.data.companyId);
    }

    // ========================================================================
    // Commercial authority — read-only for every client (Phase 4).
    // Written exclusively by the trusted backend (Admin SDK) in later phases.
    // ========================================================================
    function isSubscriptionCustomer(customerType, customerId) {
      return hasProfile() && (
        (customerType == 'company' && isNonEmptyString(me().companyId) && me().companyId == customerId)
        || (customerType == 'individual' && (
          request.auth.uid == customerId
          || (isNonEmptyString(me().employeeId) && me().employeeId == customerId)
        ))
      );
    }

    function isBillingContact(customerType, customerId) {
      return hasProfile() && (
        (customerType == 'company' && isCompanyAdmin(customerId))
        || (customerType == 'individual' && (
          request.auth.uid == customerId
          || (isNonEmptyString(me().employeeId) && me().employeeId == customerId)
        ))
      );
    }

    match /plans/{planId} {
      allow read: if true; // public pricing
      allow write: if false;
    }

    match /globalPolicies/{policyId} {
      allow read: if true;
      allow write: if false;
    }

    match /entitlementOverrides/{overrideId} {
      allow read: if isAppOwner() || isSubscriptionCustomer(resource.data.targetType, resource.data.targetId);
      allow write: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAppOwner() || isSubscriptionCustomer(resource.data.customerType, resource.data.customerId);
      allow write: if false;
    }

    match /invoices/{invoiceId} {
      allow read: if isAppOwner() || isBillingContact(resource.data.customerType, resource.data.customerId);
      allow write: if false;
    }

    match /entitlementAuditLogs/{auditId} {
      allow read: if isAppOwner();
      allow write: if false;
    }

    match /commercialAuditLogs/{auditId} {
      allow read: if isAppOwner();
      allow write: if false;
    }

    // Written by scripts/admin/* (App Owner grants/revocations).
    match /securityAuditLogs/{auditId} {
      allow read: if isAppOwner();
      allow write: if false;
    }

    // ========================================================================
    // Directive 25: backend-authoritative control plane (Cloud Functions only)
    // ========================================================================
    match /featureCatalogue/{featureId} {
      allow read: if true; // public pricing / feature matrix
      allow write: if false;
    }

    // Server-maintained usage. Customers may read their own counters only.
    match /usageCounters/{counterId} {
      allow read: if isAppOwner()
        || (resource.data.targetType == 'company' && isMemberOf(resource.data.targetId))
        || (resource.data.targetType == 'individual' && isSubscriptionCustomer('individual', resource.data.targetId));
      allow write: if false;
    }

    match /usageLedger/{entryId} {
      allow read: if isAppOwner();
      allow write: if false;
    }

    match /paymentOrders/{orderId} {
      allow read: if isAppOwner() || isBillingContact(resource.data.customerType, resource.data.customerId);
      allow write: if false;
    }

    match /webhookEvents/{eventId} {
      allow read: if isAppOwner();
      allow write: if false;
    }

    match /counters/{counterId} {
      allow read: if isAppOwner();
      allow write: if false;
    }

    // Publishing authority: the public sees PUBLISHED records only.
    match /publishingRecords/{entityId} {
      allow read: if (resource != null && resource.data.publishingState == 'PUBLISHED')
        || isAppOwner()
        || isMemberOf(resource.data.tenantId);
      allow write: if false;
    }

    match /slugs/{slug} {
      allow read: if true; // slug availability
      allow write: if false;
    }

    match /customerClassifications/{customerKey} {
      allow read: if isAppOwner() || isSubscriptionCustomer(resource.data.customerType, resource.data.customerId);
      allow write: if false;
    }

    match /platformAuditLogs/{auditId} {
      allow read: if isAppOwner();
      allow write: if false;
    }
  }
}
