rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isUnder5MB() {
      return request.resource.size <= 5 * 1024 * 1024;
    }

    // Public business card assets (company logos, headers)
    match /companies/{companyId}/branding/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImage() && isUnder5MB();
    }

    // Employee profile photos
    match /companies/{companyId}/employees/{employeeId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImage() && isUnder5MB();
    }
  }
}
