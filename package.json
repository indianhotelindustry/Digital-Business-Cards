{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:rules && npm run test:integration && npm run test:backend",
    "test:unit": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-dsbc \"vitest run --config vitest.rules.config.ts\"",
    "test:integration": "firebase emulators:exec --only auth,firestore --project demo-dsbc \"vitest run --config vitest.integration.config.ts\"",
    "test:backend": "node scripts/directive25/runBackendTests.mjs",
    "test:security": "npm run test:rules",
    "test:security:legacy": "tsx scripts/verifyRules.ts",
    "emulators": "firebase emulators:start --only firestore --project demo-dsbc",
    "seed": "tsx scripts/admin/seedDemoData.ts",
    "seed:legacy-client": "tsx scripts/seedDatabase.ts",
    "admin:set-app-owner": "tsx scripts/admin/setAppOwner.ts",
    "test:browser": "node scripts/directive26/runBrowserTests.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.3"
  }
}
